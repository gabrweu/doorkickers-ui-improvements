<!--
Equipment Picker: the Customization screen's equipment list (the big one-item-per-row list that opens when you click
an inventory slot) as a dense grid of icons, grouped under headers.

This is a separate GUI file (the game loads every .xml in a mod's gui/ folder) so the mod doesn't replace
customization.xml and stays compatible with other UI mods. The dk2_equipment_picker plugin moves #dk2ml_ep_root next
to the stock #equipment_list_parent (inside #equipment_list_panel) at runtime and shows it instead of the stock list
for the slots it handles. Without the plugin it stays hidden.

type="Callback" actions call into the plugin; their targets must still name existing items (the XML loader insists).
One screen of cells and headers is cloned from the templates into #dk2ml_ep_grid by the plugin, which lays them out
and re-skins them as the grid scrolls. Item names all start with #dk2ml_ep_ so they're unique across the whole GUI,
except each cell's #id: the game's own list code reads the hovered/clicked item's template name from a child of
that name.

Sizes: the plugin fits as many cell columns as the grid's width allows (cell width + 8 px gap), so a narrower cell
template gives more columns (shrink the icon's scale with it).
-->
<GUIItems>
	<!-- placed like the stock list (customization.xml: #equipment_list_parent align="l" origin="4 124", 548x944) -->
	<Item name="#dk2ml_ep_root" align="l" origin="4 124" sizeX="548" sizeY="944" hidden="true">

		<!-- the visible rows; the mouse wheel over it (or over a cell or header) scrolls -->
		<Item name="#dk2ml_ep_grid" sizeX="548" sizeY="944">
			<OnScrollDown>
				<Action type="Callback" target="#dk2ml_ep_grid"/>
			</OnScrollDown>
			<OnScrollUp>
				<Action type="Callback" target="#dk2ml_ep_grid"/>
			</OnScrollUp>
		</Item>

		<!-- one grid cell. The hover/click actions are the stock list item's: the game takes the item from the event
			 and the template name from its #id. Keep it without a tooltip (clones would share and double-free it) -->
		<Button name="#dk2ml_ep_cell_template" hidden="true">
			<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="605a4f80"/>
			<OnHover>
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="8f8676b0"/>
				<Action type="Callback" target="#dk2ml_ep_grid"/> <!-- shows #equipment_details_panel -->
				<Action type="TriggerEvent" target="GUI_GAME_CUSTOMIZE_HOVER_LIST_ITEM"/>
			</OnHover>
			<OnHoverEnd>
				<Action type="TriggerEvent" target="GUI_GAME_CUSTOMIZE_HOVER_LIST_ITEM_END"/>
			</OnHoverEnd>
			<OnClick>
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="f97b03b0"/>
				<!-- equips it, or opens the unlock pop-up; the game closes the list itself -->
				<Action type="TriggerEvent" target="GUI_GAME_CUSTOMIZE_ITEM_TRY_EQUIP"/>
				<Action type="PlaySound" target="gui_customize_equip"/>
			</OnClick>
			<OnScrollDown>
				<Action type="Callback" target="#dk2ml_ep_grid"/>
			</OnScrollDown>
			<OnScrollUp>
				<Action type="Callback" target="#dk2ml_ep_grid"/>
			</OnScrollUp>

			<!-- the item's icon (Equipment_Template img, eg. 360x112 for a rifle), centered in the transparent icon box: the
			     plugin swaps the texture and scales it to fit the box, never above this XML scale -->
			<StaticImage name="#dk2ml_ep_cell_iconbox" origin="0 30">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="256" sizeY="78" color="00000000"/>
				<StaticImage name="#dk2ml_ep_cell_img">
					<RenderObject2D texture="data/models/weapons/m4_ui.dds" scaleX="0.75" scaleY="0.75"/>
				</StaticImage>
			</StaticImage>
			<!-- the localized name, top-anchored under the icon so it wraps downwards. Room for two lines of paragraph_3
			     (about 28 px each): the plugin measures the wrapped text and cuts names that need a third. No sizeY, so
			     the game reports the text's height. The plugin's text can't get longer than this placeholder -->
			<StaticText name="#dk2ml_ep_cell_name" align="t" origin="0 -86" sizeX="256" wordWrap="true" font="paragraph_3" textColor="f0e3cc"
				text="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"/>
			<!-- the Equipment_Template name, for the game (hidden) -->
			<StaticText name="#id" font="paragraph_3" hidden="true"
				text="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"/>

			<!-- locked: dimmed, with the unlock cost on a stars or battle honors ribbon like the stock list's -->
			<StaticImage name="#dk2ml_ep_cell_locked" hidden="true">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="0c0b0b90"/>
				<StaticImage align="rt" origin="-2 -2">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="60" sizeY="29" color="00000000"/>
					<StaticImage name="#dk2ml_ep_cell_stars" hidden="true">
						<RenderObject2D texture="data/textures/gui/customization/stars_ribbon_normal.tga" scaleX="0.6" scaleY="0.6"/>
					</StaticImage>
					<StaticImage name="#dk2ml_ep_cell_bh" hidden="true">
						<RenderObject2D texture="data/textures/gui/customization/bh_ribbon_normal.dds" scaleX="0.6" scaleY="0.6"/>
					</StaticImage>
					<StaticText name="#dk2ml_ep_cell_cost" align="r" origin="-5 0" font="header_5" textColor="f97b03" text="XXXXXXXX"/>
				</StaticImage>
			</StaticImage>

			<!-- a squadmate has it equipped (the plugin shows it; the pop-up says who): a light tint and a small tag (the tag is the main cue, so available items stay readable) -->
			<StaticImage name="#dk2ml_ep_cell_used" hidden="true">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="0c0b0b28"/>
				<StaticImage align="rb" origin="-6 6">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="16" sizeY="16" color="f0e3cc"/>
				</StaticImage>
			</StaticImage>

			<!-- equipped: orange frame and the stock "equipped" mark. Containers inside a cell are StaticImages (with a
			     transparent texture to give them a size), not Items, which could take the cursor from the cell -->
			<StaticImage name="#dk2ml_ep_cell_equipped" hidden="true">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="146" color="00000000"/>
				<StaticImage align="t">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="3" color="f97b03"/>
				</StaticImage>
				<StaticImage align="b">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="268" sizeY="3" color="f97b03"/>
				</StaticImage>
				<StaticImage align="l">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="3" sizeY="146" color="f97b03"/>
				</StaticImage>
				<StaticImage align="r">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="3" sizeY="146" color="f97b03"/>
				</StaticImage>
				<StaticImage align="lt" origin="5 -5">
					<RenderObject2D texture="data/textures/gui/customization/icon_status_equipped.tga" scaleX="0.6" scaleY="0.6"/>
				</StaticImage>
			</StaticImage>
		</Button>

